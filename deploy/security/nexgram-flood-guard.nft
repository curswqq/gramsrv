table inet nexgram_guard {
    counter blocked_ipv4 {}
    counter blocked_ipv6 {}
    counter syn_global_drop {}
    counter syn_source_drop_ipv4 {}
    counter syn_source_drop_ipv6 {}
    counter syn_subnet_drop_ipv4 {}
    counter syn_subnet_drop_ipv6 {}
    counter syn_accepted {}

    set blocked_ipv4 {
        type ipv4_addr
        flags dynamic,timeout
        timeout 15m
        gc-interval 30s
        size 65535
    }

    set blocked_ipv6 {
        type ipv6_addr
        flags dynamic,timeout
        timeout 15m
        gc-interval 30s
        size 65535
    }

    set syn_rate_ipv4 {
        type ipv4_addr
        flags dynamic,timeout
        timeout 1m
        gc-interval 15s
        size 131072
    }

    set syn_rate_ipv6 {
        type ipv6_addr
        flags dynamic,timeout
        timeout 1m
        gc-interval 15s
        size 131072
    }

    set syn_subnet_rate_ipv4 {
        type ipv4_addr
        flags dynamic,timeout
        timeout 1m
        gc-interval 15s
        size 65535
    }

    set syn_subnet_rate_ipv6 {
        type ipv6_addr
        flags dynamic,timeout
        timeout 1m
        gc-interval 15s
        size 65535
    }

    chain preraw {
        type filter hook prerouting priority raw; policy accept;

        tcp dport { 2398, 2400 } ip saddr @blocked_ipv4 counter name blocked_ipv4 drop
        tcp dport { 2398, 2400 } ip6 saddr @blocked_ipv6 counter name blocked_ipv6 drop

        tcp dport { 2398, 2400 } tcp flags & (fin | syn | rst | ack) == syn jump tcp_syn_guard
    }

    chain tcp_syn_guard {
        # Preserve service availability during a distributed flood. This ceiling is
        # deliberately far above the normal NexGram connection establishment rate.
        limit rate over 1000/second burst 2000 packets counter name syn_global_drop drop

        meta nfproto ipv4 update @syn_rate_ipv4 { ip saddr limit rate over 50/second burst 100 packets } update @blocked_ipv4 { ip saddr timeout 15m } counter name syn_source_drop_ipv4 drop

        meta nfproto ipv6 update @syn_rate_ipv6 { ip6 saddr limit rate over 50/second burst 100 packets } update @blocked_ipv6 { ip6 saddr timeout 15m } counter name syn_source_drop_ipv6 drop

        meta nfproto ipv4 update @syn_subnet_rate_ipv4 { ip saddr & 255.255.255.0 limit rate over 400/second burst 800 packets } counter name syn_subnet_drop_ipv4 drop

        meta nfproto ipv6 update @syn_subnet_rate_ipv6 { ip6 saddr & ffff:ffff:ffff:ffff:: limit rate over 400/second burst 800 packets } counter name syn_subnet_drop_ipv6 drop

        counter name syn_accepted accept
    }
}
